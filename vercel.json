{
  "rewrites": [
    {
      "source": "/match/:slug",
      "destination": "/api/share?k=match&slug=:slug"
    },
    {
      "source": "/cycling/:slug",
      "destination": "/api/share?k=ride&slug=:slug"
    },
    {
      "source": "/cycling-event/:slug",
      "destination": "/api/share?k=ride&slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/Sportcliq_Stadium_Banner.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}